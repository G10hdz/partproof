# PartProof — sandbox only.
# BACKEND=real usa SQLite, el gate, MCP y visión; sin él corre el servidor en memoria.
BACKEND=real
# Ruta de la base SQLite; por defecto ./.data/partproof.sqlite.
PARTPROOF_DB=./.data/partproof.sqlite
# Fotos de evidencia subidas; por defecto ./.data/photos.
PARTPROOF_UPLOADS=./.data/photos
# DEMO_MODE enables the demo-only endpoints.
DEMO_MODE=1

# Payment provider: mock until a confirmed Reap sandbox key exists.
PAYMENT_PROVIDER=mock

# Vision mode: replay uses stored fixtures; live requires the Claude API.
VISION_MODE=replay

# Server-only keys. Left empty on purpose; never commit real values.
ANTHROPIC_API_KEY=
REAP_API_KEY=
APP_URL=http://localhost:3000

# Reap sandbox. Host and version confirmed against the team key.
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_VERSION=2025-02-14
# Created once by the hosted EXTERNAL enrollment; ask the team lead for the id.
REAP_ENROLLMENT_ID=
# Any static HTTPS page; checkout status is read by polling, not by the return.
REAP_RETURN_URL=https://github.com/G10hdz/partproof

# Tokens por máquina para el MCP. Usa valores distintos fuera del repositorio.
MCP_TOKEN_P1=
MCP_TOKEN_P2=
MCP_TOKEN_P3=
MCP_TOKEN_P4=

# Bot de Telegram para avisos y aprobación. Sin estas variables el bot no arranca.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Protege el cron de programaciones; sin valor definido la ruta responde 401.
CRON_SECRET=

# Demo: con COMPLETED el checkout del sandbox se da por pagado sin aprobación manual.
REAP_SIMULATE_CHECKOUT=

# Visión: anthropic u openrouter. Con openrouter, por ejemplo OPENROUTER_MODEL=minimax/minimax-m3.
VISION_PROVIDER=anthropic
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
