# PartProof demo shell — sandbox only.
# DEMO_MODE enables the demo-only endpoints; this shell never pays or gates.
DEMO_MODE=1

# Payment provider: mock until a confirmed Reap sandbox key exists.
PAYMENT_PROVIDER=mock

# Vision mode: replay uses stored fixtures; live requires the Claude API.
VISION_MODE=replay

# Server-only keys. Left empty on purpose; never commit real values.
ANTHROPIC_API_KEY=
REAP_API_KEY=

# Reap sandbox. Host and version confirmed against the team key.
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_VERSION=2025-02-14
# Created once by the hosted EXTERNAL enrollment; ask the team lead for the id.
REAP_ENROLLMENT_ID=
# Any static HTTPS page; checkout status is read by polling, not by the return.
REAP_RETURN_URL=https://github.com/G10hdz/partproof

# Tokens por máquina para el MCP. Usa valores distintos fuera del repositorio.
MCP_TOKEN_P1=
MCP_TOKEN_P2=
MCP_TOKEN_P3=
MCP_TOKEN_P4=

# Visión: anthropic u openrouter. Con openrouter, por ejemplo OPENROUTER_MODEL=google/gemini-3.8-flash.
VISION_PROVIDER=anthropic
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
