# PartProof — sandbox only.
DB_PATH=./data/app.db
# DEMO_MODE enables the demo-only endpoints.
DEMO_MODE=1

# Payment provider: mock until a confirmed Reap sandbox key exists.
PAYMENT_PROVIDER=mock

# Vision mode: replay uses stored fixtures; live requires the Claude API.
VISION_MODE=replay

# Server-only keys. Left empty on purpose; never commit real values.
ANTHROPIC_API_KEY=
REAP_API_KEY=
REAP_BASE_URL=
APP_BASE_URL=http://localhost:3000
